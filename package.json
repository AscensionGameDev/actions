{
	"name": "@intersect-engine/action-release-bundler",
	"version": "0.7.2-beta",
	"private": true,
	"description": "Action to bundle releases for the Intersect game engine",
	"main": "lib/main.js",
	"scripts": {
		"build": "tsc",
		"format": "prettier --write '**/*.ts'",
		"format-check": "prettier --check '**/*.ts'",
		"lint": "eslint src/**/*.ts",
		"package": "ncc build --source-map --license licenses.txt",
		"test": "jest",
		"all": "pnpm run build && pnpm run format && pnpm run lint && pnpm run package && pnpm test"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AscensionGameDev/actions-release-bundler.git"
	},
	"keywords": [
		"intersect"
	],
	"author": "Ascension Game Dev",
	"license": "MIT",
	"dependencies": {
		"@actions/core": "^1.11.1",
		"@types/archiver": "^6.0.3",
		"archiver": "^7.0.1",
		"glob": "^11.0.1",
		"mkdirp": "^3.0.1"
	},
	"devDependencies": {
		"@types/jest": "^29.5.14",
		"@types/node": "^22.13.10",
		"@typescript-eslint/parser": "^8.26.1",
		"@vercel/ncc": "^0.38.3",
		"eslint": "^9.22.0",
		"eslint-plugin-github": "^5.1.8",
		"eslint-plugin-jest": "^28.11.0",
		"jest": "^29.7.0",
		"js-yaml": "^4.1.0",
		"prettier": "3.5.3",
		"ts-jest": "^29.2.6",
		"typescript": "^5.8.2"
	}
}